# @BotFather dan olingan bot tokeni
BOT_TOKEN=123456789:AAExampleTokenHere

# Mini App joylashgan HTTPS manzil (Railway domenini generate qilgandan keyin shu yerga qo'ying)
# Oxirida "/" bo'lmasin
WEBAPP_URL=https://sizning-app.up.railway.app

# Restoran/menyu qo'shish-o'chirish buyruqlarini ishlata oladigan Telegram ID'lar,
# vergul bilan ajratilgan. O'z ID'ingizni bilish uchun botga /id deb yozing.
ADMIN_IDS=123456789,987654321

# Railway o'zi PORT ni beradi, lokalda ishga tushirsangiz shart emas
PORT=3000

# (ixtiyoriy) @BotFather -> /newapp orqali ro'yxatdan o'tkazilgan Mini App qisqa nomi.
# Bo'lsa, guruhda tugma bosilganda Mini App to'g'ridan-to'g'ri ochiladi.
MINIAPP_SHORT_NAME=

# (ixtiyoriy) Ma'lumotlar fayli manzili. Railway'da Volume ulasangiz, shu Volume ichiga ko'rsating.
# Import qilingan taom rasmlari ham shu fayl yonidagi images/ papkasiga saqlanadi.
# DB_PATH=/app/data/store.json
